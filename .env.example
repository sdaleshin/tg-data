DATABASE_URL=postgresql://tgdata:tgdata@localhost:5433/tgdata
SESSION_PATH=~/.tg-data/session
ARCHIVE_SINCE=2024-01-01
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Пауза между batch-запросами к Telegram (секунды)
REQUEST_PAUSE=1.0

# Интервалы scheduler (секунды)
PULL_INTERVAL_SECONDS=21600
BACKFILL_RESUME_INTERVAL_SECONDS=3600
